      "topic": "Quantitative Methods",
      "name": "Geometric mean return",
      "latex": "\\bar R_G = \\left[\\prod_{t=1}^{T}(1+R_t)\\right]^{1/T}-1",
      "variables": "R_t return in period t; T number of periods",
      "when_used": "Compound average growth rate over multiple periods",
