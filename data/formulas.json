      "topic": "Quantitative Methods",
      "name": "Sample variance",
      "latex": "s^2 = \\frac{\\sum_{i=1}^{n}(X_i-\\bar X)^2}{n-1}",
      "variables": "X_i observations; \\bar X sample mean; n sample size",
      "when_used": "Dispersion of a sample",
